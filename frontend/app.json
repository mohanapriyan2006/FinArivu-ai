{
  "expo": {
    "name": "FinArivu",
    "slug": "FinArivu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "FinArivu needs microphone access so you can use voice input in the chat.",
        "NSSpeechRecognitionUsageDescription": "FinArivu uses speech recognition to turn your voice into text in the chat."
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logo.png",
        "backgroundImage": "./assets/logo.png",
        "monochromeImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mohanapriyan2006.FinArivu"
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-speech-recognition"
    ],
    "extra": {
      "eas": {
        "projectId": "80bb18f2-224a-4ee6-9866-845fe415dc76"
      }
    }
  }
}
