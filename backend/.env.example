# Environment
ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finarivu

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-secure-random-string-in-production

# AI Providers (Multi-fallback)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxx

# CORS (all origins allowed by default)
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_RPM=100
