# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# PostgreSQL async URL
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5432/finarivu

# Security
SECRET_KEY=change-me-in-production-min-32-bytes
AES_KEY=change-me-in-production-min-16-chars
AES_KEY_SALT=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Providers (Multi-fallback)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxx

# CORS
CORS_ORIGINS=*

# Rate limiting (requests per minute)
RATE_LIMIT_RPM=100

# AI Copilot
AI_COPILOT_PROVIDER=gemini
AI_COPILOT_TEMPERATURE=0.3
AI_COPILOT_MAX_TOKENS=2048
AI_COPILOT_TIMEOUT=30
