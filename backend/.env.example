# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# PostgreSQL async URL
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5432/finarivu

# Security
SECRET_KEY=change-me-in-production-min-32-bytes
AES_KEY=change-me-in-production-min-16-chars
AES_KEY_SALT=change-me-in-production

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=
CLERK_ISSUER=

# AI Chatbot
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# CORS
CORS_ORIGINS=*

# Rate limiting (requests per minute)
RATE_LIMIT_RPM=100
